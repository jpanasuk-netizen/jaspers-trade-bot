# Port for the trading-blocks HUD (old JAP desk used 3000)
PORT=3000
HOST=127.0.0.1

# --- Judgment ---
# TypeSafe (Jev System One). Leave blank to use deterministic judge.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_ENABLED=1
JEV_TIMEOUT_SEC=2.5

# TwitterAPI.io for Jev-X social sentiment. Leave blank for market-only judge.
TWITTER_API_KEY=
TWITTER_SAMPLE=100

# --- Spin rules (old JAP open-gates snapshot) ---
STAKE_USD=2
CONF_FLOOR=0.55
ENTRY_CEIL=0.75
ENTRY_FLOOR=0.20
ENTRY_MAX_SECONDS=180
ENTRY_MIN_SECONDS=25
EDGE_FLOOR=0
TRADE_ON_LEAN=1
POLL_SEC=15
JUDGE_TTL_SEC=25
DAY_STOP_USD=1000000
SERIES_TICKER=KXBTC15M

# --- Live Kalshi orders ---
# Only honored when LIVE_MARK file exists AND keys are present.
# Paths searched if env vars empty: ~/.beat15m/ then ~/.kalshi/
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_EXCHANGE_INDEX=2
LIVE_MARK_PATH=

# Data directory for ledgers / spun windows
DATA_DIR=./data
